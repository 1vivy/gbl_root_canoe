#!/usr/bin/env python3
"""canoe - the interactive and non-interactive Canoe host entry point."""

from __future__ import annotations

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from canoelib import wizard  # noqa: E402 - importable only after the path insert above

if __name__ == "__main__":
    raise SystemExit(wizard.entry(sys.argv[1:]))
