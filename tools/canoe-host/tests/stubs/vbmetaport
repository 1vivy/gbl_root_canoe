#!/usr/bin/env python3
"""vbmetaport: graft a vbmeta onto a third-party image, size preserved.

Fixture stand-in for the real toolkit binary. Records its call in $CANOE_TRACE
so tests can assert the order the driver invokes the pipeline in.
"""

from __future__ import annotations

import os
import sys
from pathlib import Path


def trace(line: str) -> None:
    path = os.environ.get("CANOE_TRACE")
    if path:
        with open(path, "a", encoding="utf-8") as handle:
            handle.write(line + "\n")


def main(argv: list[str]) -> int:
    vbmeta, target, out = Path(argv[0]), Path(argv[1]), Path(argv[2])
    trace(f"vbmetaport {target.name}")
    if not (vbmeta.is_file() and target.is_file()):
        sys.stderr.write("vbmetaport: missing input\n")
        return 1
    if os.environ.get("STUB_VBMETAPORT") == "grow":
        out.write_bytes(target.read_bytes() + b"OVERFLOW")
        return 0
    if os.environ.get("STUB_VBMETAPORT") == "fail":
        return 1
    payload = bytearray(target.read_bytes())
    payload[: len(b"GRAFTED")] = b"GRAFTED"
    out.write_bytes(bytes(payload))
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
