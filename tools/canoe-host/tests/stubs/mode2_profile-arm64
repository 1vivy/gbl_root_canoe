#!/usr/bin/env python3
"""mode2_profile (Android arm64): read and write the BDS preferred-mode record.

Fixture stand-in pushed on-device by `canoe_stage --mode`. Implements exactly
the surface the driver uses - mode-write then mode-read - against the fixture
file standing in for the efisp partition.
"""

from __future__ import annotations

import sys
from pathlib import Path

RECORD_OFFSET_FROM_END = 3072
RECORD_BYTES = 1024
MAGIC = b"SFBM1|"


def main(argv: list[str]) -> int:
    command, *rest = argv
    options = dict(zip(rest[::2], rest[1::2]))
    device = Path(options["--device"])
    partition_bytes = int(options["--partition-bytes"])
    block_size = int(options["--block-size"])
    if partition_bytes < 1024 * 1024 or partition_bytes % block_size:
        sys.stderr.write("mode2_profile: unusable geometry\n")
        return 1
    offset = partition_bytes - RECORD_OFFSET_FROM_END

    with device.open("r+b") as handle:
        if command == "mode-read":
            handle.seek(offset)
            head = handle.read(len(MAGIC) + 1)
            if head.startswith(MAGIC) and head[-1:] in (b"0", b"1", b"2"):
                print(f"MODE={head[-1:].decode()}|MODE_DEFAULTED=0")
            else:
                print("MODE=1|MODE_DEFAULTED=1")
            return 0
        if command == "mode-write":
            mode = options["--mode"]
            if mode not in ("0", "1", "2"):
                return 1
            handle.seek(offset)
            handle.write((MAGIC + mode.encode()).ljust(RECORD_BYTES, b"\0"))
            return 0
    return 1


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
