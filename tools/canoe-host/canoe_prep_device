#!/usr/bin/env python3
"""canoe_prep_device - derive the canoe boot chain from the device itself.

Thin launcher. The implementation is canoe/prep_device.py, shared by the Linux and
the Windows toolkit, so both platforms run one driver instead of one each.
"""

from __future__ import annotations

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from canoe import prep_device  # noqa: E402 - importable only after the path insert above

if __name__ == "__main__":
    raise SystemExit(prep_device.entry(sys.argv[1:]))
