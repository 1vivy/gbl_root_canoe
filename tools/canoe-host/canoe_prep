#!/usr/bin/env python3
"""canoe_prep - prepare a stock firmware package for a gbl_root_canoe install.

Thin launcher. The implementation is canoe/prep.py, shared by the Linux and
the Windows toolkit, so both platforms run one driver instead of one each.
"""

from __future__ import annotations

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from canoe import prep  # noqa: E402 - importable only after the path insert above

if __name__ == "__main__":
    raise SystemExit(prep.entry(sys.argv[1:]))
