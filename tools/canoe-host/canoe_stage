#!/usr/bin/env python3
"""canoe_stage - install the prepared canoe boot chain over ADB.

Thin launcher. The implementation is canoe/stage.py, shared by the Linux and
the Windows toolkit, so both platforms run one driver instead of one each.
"""

from __future__ import annotations

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from canoe import stage  # noqa: E402 - importable only after the path insert above

if __name__ == "__main__":
    raise SystemExit(stage.entry(sys.argv[1:]))
