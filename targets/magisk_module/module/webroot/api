#!/system/bin/sh
# WebUI CGI 接口：无 ksu bridge 时由前端 HTTP 调用（第三方工具/浏览器场景）。
# 只暴露白名单动作，避免任意命令执行。

SELF="$0"
[ -L "$SELF" ] && SELF="$(readlink "$SELF")"
WEBROOT="$(CDPATH= cd -- "$(dirname "$SELF")" 2>/dev/null && pwd)"
MODDIR="${MODDIR:-$(dirname "$WEBROOT")}"
BIN="$MODDIR/bin/bl_flasher.sh"

QUERY="${QUERY_STRING:-}"
a=""
arg=""
for pair in $(printf '%s' "$QUERY" | tr '&' '\n'); do
  [ -z "$pair" ] && continue
  k="${pair%%=*}"
  v="${pair#*=}"
  [ "$k" = "a" ] && a="$v"
  [ "$k" = "arg" ] && arg="$v"
done

urldecode() { printf '%b' "$(printf '%s' "$1" | sed 's/+/ /g; s/%/\\x/g')"; }
a="$(urldecode "$a")"
arg="$(urldecode "$arg")"

printf 'Content-Type: text/plain; charset=utf-8\r\n\r\n'

case "$a" in
  info)        echo "MODDIR=$MODDIR" ;;
  status)      MODDIR="$MODDIR" sh "$BIN" status ;;
  tail)        MODDIR="$MODDIR" sh "$BIN" tail "${arg:-200}" ;;
  start)       MODDIR="$MODDIR" sh "$BIN" start "$arg" ;;
  start-patch) MODDIR="$MODDIR" sh "$BIN" start-patch "$arg" ;;
  clear-log)   MODDIR="$MODDIR" sh "$BIN" clear-log ;;
  *)           echo "ERROR=unknown action" ;;
esac
