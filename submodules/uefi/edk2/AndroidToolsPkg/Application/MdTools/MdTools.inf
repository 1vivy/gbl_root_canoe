[Defines]
  INF_VERSION                    = 0x00010006
  BASE_NAME                      = MdTools
  FILE_GUID                      = 7C2E4A18-9F35-4B6D-8E1A-3D5C7B90A2E4
  MODULE_TYPE                    = UEFI_APPLICATION
  VERSION_STRING                 = 0.1
  ENTRY_POINT                    = MdToolsEntry

[Sources]
  MdTools.c
  MdTools.h
  MdShadow.h
  MdShadowModel.c
  MdShadow.c
  MdDiscovery.c
  MdReport.c
  MdEdit.c

[Packages]
  ArmPkg/ArmPkg.dec
  MdePkg/MdePkg.dec
  AndroidToolsPkg/AndroidToolsPkg.dec
  QcomModulePkg/QcomModulePkg.dec

[LibraryClasses]
  AndroidToolsUi
  AndroidToolsEvidence
  BaseLib
  BaseMemoryLib
  CacheMaintenanceLib
  MdTableLib
  MemoryAllocationLib
  PrintLib
  UefiApplicationEntryPoint
  UefiBootServicesTableLib
  UefiLib
