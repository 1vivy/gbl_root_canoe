[Defines]
  INF_VERSION                    = 0x00010006
  BASE_NAME                      = FdLoader
  FILE_GUID                      = DE5149DC-E248-4CF2-B18B-FC7C4DAEC0CF
  MODULE_TYPE                    = UEFI_APPLICATION
  VERSION_STRING                 = 0.1
  ENTRY_POINT                    = FdLoaderEntry

[Sources]
  FdLoader.c

[Packages]
  MdePkg/MdePkg.dec
  ArmPkg/ArmPkg.dec
  AndroidToolsPkg/AndroidToolsPkg.dec

[LibraryClasses]
  UefiApplicationEntryPoint
  UefiBootServicesTableLib
  UefiLib
  BaseLib
  BaseMemoryLib
  MemoryAllocationLib
  DebugLib
  PrintLib
  AtRawBoot

[Protocols]
  gEfiLoadedImageProtocolGuid
