#/** @file
#  AbootLoader UEFI application - native arm64 Android boot image loader.
#
#  Parses Android boot image v3/v4 and vendor_boot v3/v4 images from the
#  launch volume, prepares their kernel handoff state, and jumps natively.
#
#  Copyright (c) 2026, contributors to the canoe ABL tree.
#  SPDX-License-Identifier: BSD-3-Clause
#**/

[Defines]
  INF_VERSION                    = 0x00010006
  BASE_NAME                      = AbootLoader
  FILE_GUID                      = D71E8BA3-4A42-4B86-BF33-3D5C7A2E9014
  MODULE_TYPE                    = UEFI_APPLICATION
  VERSION_STRING                 = 0.1
  ENTRY_POINT                    = AbootLoaderEntry

[Sources]
  AbootLoader.c

[Packages]
  MdePkg/MdePkg.dec
  ArmPkg/ArmPkg.dec
  AndroidToolsPkg/AndroidToolsPkg.dec

[LibraryClasses]
  UefiApplicationEntryPoint
  UefiBootServicesTableLib
  UefiLib
  BaseLib
  BaseMemoryLib
  MemoryAllocationLib
  DebugLib
  PrintLib
  AtRawBoot

[Protocols]
  gEfiLoadedImageProtocolGuid
