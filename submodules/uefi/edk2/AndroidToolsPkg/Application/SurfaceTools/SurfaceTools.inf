[Defines]
  INF_VERSION                    = 0x00010006
  BASE_NAME                      = SurfaceTools
  FILE_GUID                      = 8347084D-122A-4EC1-8F60-902A94859197
  MODULE_TYPE                    = UEFI_APPLICATION
  VERSION_STRING                 = 0.1
  ENTRY_POINT                    = SurfaceToolsEntry

[Sources]
  SurfaceTools.c
  SurfaceDump.h
  SurfaceDump.c
  SurfaceInventory.h
  SurfaceInventory.c
  SurfaceRuntime.c
  SurfaceProbes.c
  SurfaceModel.h
  SurfaceModel.c

[Packages]
  ArmPkg/ArmPkg.dec
  MdePkg/MdePkg.dec
  AndroidToolsPkg/AndroidToolsPkg.dec
  QcomModulePkg/QcomModulePkg.dec

[LibraryClasses]
