# macOS System Files
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Logs
*.log
logs/
*.syslog

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
.pytest_cache/
venv/
# Download cache for pinned package assets
.cache/*
# Rust — every in-tree tool, not just the first one
tools/*/target/

ENV/

# ABL/GBL Binary & Build Assets
*.bin
*.img
!tools/mode2-profile/tests/fixtures/*.img
# Hand-built AVB blobs the bootmgr protocol goldens read by path; without the
# exception they are ignored, and the vbmeta suite only passes on the machine
# that happened to generate them.
!tools/canoe-bootmgr/tests/fixtures/*.img
*.efi
!submodules/uefi/blobs/*.efi
extracted/

# Track abl images in the ablrepo (checked-in artifacts, not build output)
!ablrepo/**/*.img

# VS Code
.vscode/

# Session scratch: device dumps, pulled UefiLogs, one-off host tools
.work/

# Local agent guidance and harness state, deliberately not published.
# .omo/ holds plans, per-task evidence and a task DAG; .pi/ holds memory
# cursors and receipts. Both are session state, and .omo/ reaches tens of MB.
AGENTS.md
.omo/
.pi/

submodules/uefi/edk2/build_modulepkg.log
# Locally built ext4 helper binary
/tools/canoe-ext4/canoe-ext4
/tools/canoe-ext4/canoe-ext4.exe
/tools/canoe-ext4/.e2fsprogs-mingw-build/

submodules/unsigned_abl.elf
# Build-generated by submodules/uefi/embed_variant.py
submodules/uefi/edk2/QcomModulePkg/Application/LinuxLoader/Generated/
